{
  "name": "@nexusid/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Privacy-preserving digital identity verification using Selective Disclosure JWT",
  "scripts": {
    "dev": "concurrently \"tsx watch src/index.ts\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "prisma migrate dev",
    "seed": "ts-node src/db/seed.ts",
    "generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand"
  },
  "dependencies": {
    "@nexusid/sd-jwt": "^1.0.0",
    "@nexusid/types": "^1.0.0",
    "@prisma/client": "6.19.3",
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.9",
    "morgan": "^1.11.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.2.0",
    "concurrently": "^8.2.2",
    "prisma": "6.19.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "compilerOptions": {
    "isolatedModules": "true"
  }
}
