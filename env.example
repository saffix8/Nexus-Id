# =============================================================
# NexusID — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# ── DATABASE ──────────────────────────────────────────────────
DATABASE_URL=postgresql://nexusid:password@localhost:5432/nexusid_db

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=7d

# ── FIREBASE (Push Notifications) ────────────────────────────
FIREBASE_PROJECT_ID=nexusid-app
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@nexusid-app.iam.gserviceaccount.com

# ── NADRA VERISYS ─────────────────────────────────────────────
NADRA_CLIENT_ID=your_nadra_client_id
NADRA_CLIENT_SECRET=your_nadra_client_secret
NADRA_FRANCHISE_CODE=your_franchise_code
NADRA_USE_SANDBOX=true

# ── HEC DEGREE VERIFICATION ──────────────────────────────────
HEC_API_KEY=your_hec_api_key
HEC_BASE_URL=https://api.hec.gov.pk/degree-verification/v2

# ── LINKEDIN OAUTH ────────────────────────────────────────────
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:4004/api/v1/credentials/linkedin/callback

# ── ML FRAUD DETECTION ───────────────────────────────────────
ML_SERVICE_URL=http://localhost:5001

# ── HYPERLEDGER FABRIC ────────────────────────────────────────
FABRIC_CHANNEL=nexusid-channel
FABRIC_CHAINCODE=credential-audit

# ── SERVER ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── ISSUER SERVICE PORTS ─────────────────────────────────────
NADRA_SERVICE_PORT=4001
HEC_SERVICE_PORT=4002
AU_SERVICE_PORT=4003
LINKEDIN_SERVICE_PORT=4004

# ── ISSUER PRIVATE KEYS (auto-generated by scripts/generate-issuer-keys.ts) ──
NADRA_ISSUER_PRIVATE_KEY=
HEC_ISSUER_PRIVATE_KEY=
AU_ISSUER_PRIVATE_KEY=
LINKEDIN_ISSUER_PRIVATE_KEY=

# ── WEB APP (copy to apps/web/.env.local) ────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_this_to_a_long_random_string
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=NexusID

# ── MOBILE APP (copy to apps/mobile/.env) ────────────────────
API_URL=http://10.0.2.2:4000/api/v1
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
