generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicKey            String?               @map("public_key")
  pushToken            String?               @map("push_token")
  deviceInfo           Json?                 @map("device_info")
  email                String?               @unique
  passwordHash         String?               @map("password_hash")
  name                 String?
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  credentials          Credential[]
  pairings             DevicePairing[]
  verificationRequests VerificationRequest[]

  @@map("users")
}

model Credential {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  issuerCredentialId String    @unique @map("issuer_credential_id")
  /// `jti` of the issued SD-JWT — matches presented proofs to this row (BR-006).
  credentialJti      String?   @unique @map("credential_jti")
  issuerDid          String    @map("issuer_did")
  issuerName         String    @map("issuer_name")
  credentialType     String    @map("credential_type")
  status             String    @default("active")
  metadata           Json
  issuedAt           DateTime  @map("issued_at") @db.Timestamptz(6)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  revocationReason   String?   @map("revocation_reason")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("credentials")
}

enum CredentialStatus {
  active
  expired
  revoked

  @@map("credential_status")
}

model Verifier {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domain               String                @unique
  displayName          String                @map("display_name")
  logoUrl              String?               @map("logo_url")
  /// SHA-256 hex of the API key (FR-034). The plaintext key is shown once, never stored.
  apiKey               String                @unique @map("api_key")
  /// First characters of the current key, for display only (e.g. "nxk_ab12").
  apiKeyPrefix         String?               @map("api_key_prefix")
  apiKeyRotatedAt      DateTime?             @map("api_key_rotated_at") @db.Timestamptz(6)
  /// Service Provider portal login (FR-033, BR-008: unique across providers).
  email                String?               @unique
  passwordHash         String?               @map("password_hash")
  trusted              Boolean               @default(false)
  /// Predicate codes this provider may request (FR-041, API-045/046). Catalog codes only (BR-021).
  requiredPredicates   String[]              @default([]) @map("required_predicates")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  verificationRequests VerificationRequest[]

  @@map("verifiers")
}

model VerificationRequest {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  verifierId      String?             @map("verifier_id") @db.Uuid
  /// The End User this request was routed to, via the extension's pairing (FR-003).
  userId          String?             @map("user_id") @db.Uuid
  /// Legacy: kept equal to [predicate] for older clients. `predicate` is authoritative.
  requestedFields String[]            @map("requested_fields")
  /// The catalog predicate this session asks for (FR-043, BR-021).
  predicate       String?
  nonce           String              @unique
  callbackUrl     String?             @map("callback_url")
  pageUrl         String?             @map("page_url")
  /// pending | completed (VERIFIED) | failed (FAILED) | rejected (DECLINED) | expired (EXPIRED)
  status          String              @default("pending")
  expiresAt       DateTime            @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt     DateTime?           @map("completed_at") @db.Timestamptz(6)
  rejectedAt      DateTime?           @map("rejected_at") @db.Timestamptz(6)
  /// When the extension relayed this session to the paired device (API-032, FR-032).
  relayedAt       DateTime?           @map("relayed_at") @db.Timestamptz(6)
  /// SHA-256 of the poll secret the extension uses to read the outcome (API-033).
  pollSecretHash  String?             @unique @map("poll_secret_hash")
  fraudFlags      FraudFlag[]
  verifier        Verifier?           @relation(fields: [verifierId], references: [id])
  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  result          VerificationResult?

  @@index([status])
  @@index([verifierId])
  @@index([userId])
  @@index([expiresAt])
  @@index([nonce])
  @@index([createdAt(sort: Desc)])
  @@map("verification_requests")
}

/// BR-015: only the outcome, the condition name, the proof hash and the issuer.
/// Never claim values.
model VerificationResult {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId      String              @unique @map("request_id") @db.Uuid
  /// VERIFIED | FAILED
  outcome        String
  /// Predicate code the session asked for.
  condition      String
  /// Issuer ID of the presented credential; null when no proof was presented (API-037).
  issuer         String?
  /// SHA-256 of the submitted proof; null when no proof was presented (API-037).
  proofHash      String?             @map("proof_hash")
  /// When the outcome was recorded.
  verifiedAt     DateTime            @map("verified_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  request        VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([verifiedAt(sort: Desc)])
  @@index([issuer])
  @@map("verification_results")
}

model IssuerRegistry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issuerId  String   @unique @map("issuer_id")
  name      String
  jwksUrl   String   @map("jwks_url")
  publicKey String   @map("public_key")
  active    Boolean  @default(true)
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([active])
  @@map("issuer_registry")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  eventType  String   @map("event_type")
  requestId  String?  @map("request_id") @db.Uuid
  verifierId String?  @map("verifier_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([eventType, createdAt(sort: Desc)])
  @@index([requestId])
  @@index([verifierId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model FraudFlag {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId String?              @map("request_id") @db.Uuid
  riskScore Decimal?             @map("risk_score") @db.Decimal(5, 2)
  riskLevel String?              @map("risk_level")
  features  Json?
  status    String               @default("pending")
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  request   VerificationRequest? @relation(fields: [requestId], references: [id])

  @@index([status])
  @@index([riskLevel])
  @@index([createdAt(sort: Desc)])
  @@map("fraud_flags")
}

model UsedNonce {
  nonce  String   @id
  usedAt DateTime @default(now()) @map("used_at") @db.Timestamptz(6)

  @@index([usedAt])
  @@map("used_nonces")
}

enum VerificationStatus {
  pending
  completed
  rejected
  expired

  @@map("verification_status")
}

enum FraudFlagStatus {
  pending
  reviewed
  dismissed

  @@map("fraud_flag_status")
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH

  @@map("risk_level")
}

/// Browser extension <-> mobile device pairing (SRS UC-002, FR-003, FR-024, BR-002).
/// The extension creates a pending row and shows its code as a QR; the signed-in
/// mobile app claims it, linking that browser session to the End User.
/// Only SHA-256 hashes of the QR code and the extension's secret are stored.
model DevicePairing {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codeHash   String    @unique @map("code_hash")
  secretHash String    @unique @map("secret_hash")
  userId     String?   @map("user_id") @db.Uuid
  /// pending | paired | revoked  (an unclaimed row past expiresAt is expired)
  status     String    @default("pending")
  /// QR validity window — the code cannot be claimed after this (BR-002)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  pairedAt   DateTime? @map("paired_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("device_pairings")
}
